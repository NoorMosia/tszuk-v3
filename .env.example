# Formspree contact adapter (optional).
# The contact form is env-gated: with this unset the form degrades to a
# success state + mailto:hello@tszuk.co.za fallback and never touches the network.
# Set it to enable submission via Formspree (https://formspree.io). Real values
# live only in local .env and Vercel env settings — never commit credentials.
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/mvkgwvar
