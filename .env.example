# Supabase contact adapter (optional).
# The contact form is env-gated: with both values unset the form degrades to a
# success state + mailto:hello@tszuk.com fallback and never touches the network.
# Set both to enable server-side submission. Real values live only in local .env
# and Vercel env settings — never commit credentials.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
