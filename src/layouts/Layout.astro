---
import { ClientRouter } from 'astro:transitions';
import SmoothScroll from '../components/SmoothScroll.astro';
import Nav from '../components/Nav.astro';
import BrandedLoader from '../components/BrandedLoader.astro';
import StructuredData from '../components/StructuredData.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  /** Pixel dimensions of the social image, used for og:image:width/height hints. */
  imageWidth?: number;
  imageHeight?: number;
  /** Open Graph object type. Pages default to 'website'; case studies pass 'article'. */
  ogType?: 'website' | 'article';
}

const siteUrl = Astro.site?.href || Astro.url.origin || 'https://tszuk.co.za';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

const {
  title = 'tszuk | a brand that builds',
  description = 'tszuk is a branding studio collaborating with companies and personalities to build identities that resonate.',
  image = '/og-image.png',
  imageAlt = 'tszuk — a brand that builds',
  imageWidth = 1200,
  imageHeight = 630,
  ogType = 'website',
} = Astro.props;

const ogImageUrl = new URL(image, siteUrl).href;
// Best-effort image MIME type from the file extension (defaults to PNG, the
// site's default social card). Used for og:image:type.
const imageExt = ogImageUrl.split('?')[0].split('.').pop()?.toLowerCase();
const ogImageType =
  imageExt === 'jpg' || imageExt === 'jpeg'
    ? 'image/jpeg'
    : imageExt === 'webp'
      ? 'image/webp'
      : 'image/png';
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="only light" />
    <meta name="description" content={description} />
    <meta name="author" content="tszuk" />
    <meta name="theme-color" content="#FDFDFC" />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content="tszuk" />
    <meta property="og:locale" content="en_ZA" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:site" content="@tszuk" />
    <meta name="twitter:creator" content="@tszuk" />

    <!-- Bing/Yahoo image support -->
    <link rel="image_src" href={ogImageUrl} />

    <!-- Space Grotesk (body + headings) · Instrument Serif (italic accent) · JetBrains Mono (metadata) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" href="/favicon/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <title>{title}</title>

    <ClientRouter />
    <StructuredData scope="site" />

    <!-- Remove no-js class immediately -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body>
    <SmoothScroll transition:persist="smooth-scroll" />
    <BrandedLoader transition:persist />
    <header class="site-header">
      <Nav />
    </header>
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Keep the `no-js` class off <html> across client-side navigations.
      // The inline <script> in <head> strips it only on the initial parse and
      // is NOT re-run by ClientRouter, so after a view transition the incoming
      // document can restore `<html class="no-js">`. That would wrongly trigger
      // every `.no-js` fallback (e.g. the nav collapses to a plain bulleted
      // list with no hamburger). Re-strip it on swap and on every page load.
      function dropNoJs() {
        document.documentElement.classList.remove('no-js');
      }
      // `before-swap` fires on the incoming document before it is shown, so the
      // fallback styles never get a chance to paint.
      document.addEventListener('astro:before-swap', (e) => {
        const doc = (e as any).newDocument as Document | undefined;
        if (doc) doc.documentElement.classList.remove('no-js');
      });
      document.addEventListener('astro:after-swap', dropNoJs);
      document.addEventListener('astro:page-load', dropNoJs);

      // Synchronize URL updates with motion logic by deferring to the next frame
      // after astro:page-load, ensuring ClientRouter has fully committed the URL
      // change before scroll-reveal or other motion handlers fire.
      function synchronizeNavigation() {
        requestAnimationFrame(() => {
          // Now the URL is definitely updated; safe to proceed with motion logic.
          window.dispatchEvent(new Event('tszuk:nav-committed'));
        });
      }
      document.addEventListener('astro:page-load', synchronizeNavigation);

      // Reveal safety net (Req 10.7): if any motion init fails, ensure no
      // scroll-reveal element is ever left hidden. Runs after navigation sync.
      function revealSafetyNet() {
        window.setTimeout(() => {
          document
            .querySelectorAll('.scroll-reveal:not(.visible)')
            .forEach((el) => el.classList.add('visible'));
        }, 1200);
      }
      document.addEventListener('tszuk:nav-committed', revealSafetyNet);
    </script>
  </body>
</html>

<style>
  /* Fixed (not sticky) so the header reserves no layout space and overlays the
     hero. The nav is always visible and clickable; it only swaps from a
     transparent to a solid/blurred background once the page is scrolled. */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 150;
  }

  main {
    position: relative;
    z-index: 1;
    /* Clear the fixed header so page content never tucks under the nav. */
    padding-top: var(--nav-height);
  }
</style>

<style is:global>
  @import '../styles/global.css';
</style>
