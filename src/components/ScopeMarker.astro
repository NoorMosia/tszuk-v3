---
/**
 * ScopeMarker — modern replacement for filled scope pills.
 *
 * `inline` (default): scope values as middot-separated text with no filled
 * background, for cards and summaries.
 * `rows`: a "Scope" label paired with the values as a key-value row, for the
 * case study page.
 *
 * Values derive from the entry's scope array; there is no pill styling anywhere.
 */
interface Props {
  scope: string[];
  variant?: 'inline' | 'rows';
  align?: 'start' | 'center';
  class?: string;
}

const { scope, variant = 'inline', align = 'start', class: className } = Astro.props;
---

{
  variant === 'inline' ? (
    <p
      class:list={['scope', 'scope--inline', `scope--${align}`, className]}
      aria-label="Scope of work"
    >
      {scope.map((item, i) => (
        <>
          {i > 0 && <span class="scope__sep" aria-hidden="true">&middot;</span>}
          <span class="scope__item">{item}</span>
        </>
      ))}
    </p>
  ) : (
    <div class:list={['scope', 'scope--rows', className]}>
      <span class="scope__label">Scope</span>
      <p class="scope__values">
        {scope.map((item, i) => (
          <>
            {i > 0 && <span class="scope__sep" aria-hidden="true">&middot;</span>}
            <span class="scope__item">{item}</span>
          </>
        ))}
      </p>
    </div>
  )
}

<style>
  .scope {
    margin: 0;
    padding: 0;
  }

  .scope__item {
    font-family: var(--font-mono);
    font-size: var(--font-size-mono);
    font-weight: var(--font-weight-mono);
    letter-spacing: var(--letter-spacing-mono);
    color: var(--color-muted);
    /* inline-block makes each value a single breakable unit: the line can wrap
       BETWEEN items (so the row never overflows the screen), while `nowrap`
       keeps a multi-word value like "Visual Storytelling" whole rather than
       splitting mid-phrase. Plain inline spans with only margin between them
       gave the browser no break opportunity, forcing one long overflowing line. */
    display: inline-block;
    white-space: nowrap;
  }

  .scope__sep {
    display: inline-block;
    color: var(--color-accent);
    margin: 0 0.5rem;
  }

  /* Inline: middot-separated run of text. */
  .scope--inline {
    display: block;
    line-height: 1.7;
  }

  .scope--center {
    text-align: center;
  }

  .scope--start {
    text-align: left;
  }

  /* Rows: "Scope" label + values, reads like a spec sheet.
     Mobile-first: stack the label above the values (left-aligned) so the
     values get the full column width to wrap between items. The side-by-side
     right-aligned spec-sheet look is layered on at the wider breakpoint. */
  .scope--rows {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: var(--rule-hair) solid var(--color-divider);
    border-bottom: var(--rule-hair) solid var(--color-divider);
    padding: 1rem 0;
  }

  .scope__label {
    font-family: var(--font-mono);
    font-size: var(--font-size-mono);
    font-weight: var(--font-weight-mono);
    letter-spacing: var(--letter-spacing-mono);
    color: var(--color-muted);
  }

  .scope--rows .scope__values {
    margin: 0;
    padding: 0;
    text-align: left;
    /* Wrap between items (spaces around the middots) but never mid-word. */
    line-height: 1.7;
  }

  @media (min-width: 640px) {
    .scope--rows {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.75rem 1.25rem;
      align-items: baseline;
    }

    .scope--rows .scope__values {
      text-align: right;
    }
  }
</style>
