---
/**
 * BusinessRow — editorial full-width row for a single business.
 *
 * Image on one side, text on the other, aligned to the 12-column grid. The
 * image side alternates by index parity (even = image left, odd = image right)
 * so consecutive rows read as a zig-zag. Every field derives from the entry.
 * On mobile the row collapses to a single column with the image above the text.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ScopeMarker from './ScopeMarker.astro';
import { businessRowImageSide } from '../lib/layout';

interface Props {
  entry: CollectionEntry<'caseStudies'>;
  index?: number;
}

const { entry, index = 0 } = Astro.props;
const { data } = entry;
const href = `/work/${entry.id}/`;
const imageSide = businessRowImageSide(index);
const revealDelay = `${Math.min(index, 6) * 80}ms`;
---

<article
  class:list={['brow scroll-reveal', `brow--image-${imageSide}`]}
  style={`--reveal-delay: ${revealDelay}`}
>
  <a class="brow__media" href={href} tabindex="-1" aria-hidden="true">
    <div class="brow__frame">
      <Image
        src={data.heroImage}
        alt={data.heroImageAlt}
        width={1000}
        height={800}
        class="brow__image"
        loading="lazy"
      />
    </div>
  </a>

  <div class="brow__text">
    <h3 class="brow__name">
      <a class="brow__name-link" href={href}>{data.name}</a>
    </h3>
    <p class="brow__description">{data.description}</p>
    {
      data.liveLink && (
        <a
          class="brow__visit"
          href={data.liveLink}
          target="_blank"
          rel="noopener noreferrer"
        >
          Visit site <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .brow {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    align-items: center;
    padding-block: 0;
    border-top: none;
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity var(--duration-reveal) var(--easing) var(--reveal-delay, 0ms),
      transform var(--duration-reveal) var(--easing) var(--reveal-delay, 0ms);
  }

  .brow.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .brow__frame {
    display: block;
    overflow: hidden;
    background-color: var(--color-sage-tint);
    border-radius: 0;
    aspect-ratio: 5 / 4;
  }

  .brow__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-hover) var(--easing);
  }

  .brow:hover .brow__image {
    transform: scale(var(--hover-scale));
  }

  .brow__text {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    align-items: flex-start;
    padding: clamp(2rem, 5vw, 4rem);
  }

  .brow__name {
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .brow__name-link {
    color: var(--color-text);
  }

  .brow__name-link:hover {
    color: var(--color-accent);
  }

  .brow__description {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 42ch;
  }

  .brow__visit {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--font-size-mono);
    font-weight: var(--font-weight-mono);
    letter-spacing: var(--letter-spacing-mono);
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 2px;
    transition: opacity var(--duration-hover) var(--easing);
  }

  .brow__visit:hover {
    opacity: 0.7;
  }

  /* Desktop: two columns, image side driven by modifier. */
  @media (min-width: 768px) {
    .brow {
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }

    /* Image left (default source order). */
    .brow--image-left .brow__media {
      grid-column: 1;
      grid-row: 1;
    }
    .brow--image-left .brow__text {
      grid-column: 2;
      grid-row: 1;
    }

    /* Image right: swap columns while keeping DOM order (media first). */
    .brow--image-right .brow__media {
      grid-column: 2;
      grid-row: 1;
    }
    .brow--image-right .brow__text {
      grid-column: 1;
      grid-row: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brow {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .brow:hover .brow__image {
      transform: none;
    }
  }
</style>
