---
import { Image } from 'astro:assets';
import zukisa from '../assets/Zukisa.png';
import tshepo from '../assets/tshepo.png';

interface Props {
  /** When true, renders expanded biography prose alongside each founder. */
  expanded?: boolean;
  /** Heading level/text override for the section title. */
  title?: string;
  /** Render the component's own title. Set false when the page supplies one. */
  showTitle?: boolean;
}

const { expanded = false, title = 'Behind the Brand', showTitle = true } =
  Astro.props;

const zukisaBio = [
  'Zukisa ensures every project runs like clockwork. He orchestrates the whole process, from understanding what a client really needs to making sure the final work delivers on the vision.',
  'He keeps the momentum going and the standards high, always thinking about what will actually resonate with the people it\'s made for.',
];

const tshepoBio = [
  'Mosia makes the vision hold together. He builds the systems and experiences that carry a brand across every touchpoint, so the polish you feel on the surface is matched by something solid underneath.',
  'He is happiest where design meets logic, turning a beautiful idea into something that actually works, quietly and reliably, for the people who use it.',
];
---

<section
  class:list={['minds scroll-reveal', { 'minds--expanded': expanded }]}
  aria-label="The minds behind tszuk"
>
  {showTitle && <h2 class="minds__title">{title}</h2>}
  <div class="minds__grid">
    <div class="minds__person">
      <div class="minds__portrait-wrapper">
        <div class="minds__blob minds__blob--green" aria-hidden="true"></div>
        <Image
          src={zukisa}
          alt="Zukisa, Co-Founder and Project Manager at tszuk"
          width={400}
          height={400}
          class="minds__portrait"
          loading="lazy"
        />
        <div class="minds__overlay">
          <span class="minds__tag">Project Management</span>
        </div>
      </div>
      <h3 class="minds__name">Zukisa</h3>
      <p class="minds__role">Co-Founder & Project Manager</p>
      {
        expanded && (
          <div class="minds__bio">
            {zukisaBio.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        )
      }
    </div>
    <div class="minds__person">
      <div class="minds__portrait-wrapper">
        <div class="minds__blob minds__blob--red" aria-hidden="true"></div>
        <Image
          src={tshepo}
          alt="Mosia, Co-Founder and Systems Director at tszuk"
          width={400}
          height={400}
          class="minds__portrait"
          loading="lazy"
        />
        <div class="minds__overlay">
          <span class="minds__tag">Systems & Engineering</span>
        </div>
      </div>
      <h3 class="minds__name">Mosia</h3>
      <p class="minds__role">Co-Founder & Systems Director</p>
      {
        expanded && (
          <div class="minds__bio">
            {tshepoBio.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  function initMinds() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const section = document.querySelector('.minds') as HTMLElement | null;
    if (!section) return;

    if (prefersReducedMotion) {
      section.classList.add('visible');
      return;
    }
    if (section.dataset.motionInit === 'true') return;
    section.dataset.motionInit = 'true';

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.15 }
    );
    observer.observe(section);
  }

  document.addEventListener('astro:page-load', initMinds);
</script>

<style>
  .minds {
    padding: var(--section-padding-mobile) 1.5rem;
    width: 100%;
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity var(--duration-reveal) var(--easing),
      transform var(--duration-reveal) var(--easing);
  }

  .minds.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .minds__title {
    font-family: var(--font-mono);
    font-size: var(--font-size-mono);
    font-weight: var(--font-weight-mono);
    letter-spacing: var(--letter-spacing-mono);
    color: var(--color-muted);
    margin-bottom: 4rem;
    text-align: center;
  }

  .minds__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    justify-items: center;
  }

  .minds__person {
    text-align: center;
  }

  .minds__portrait-wrapper {
    position: relative;
    display: inline-block;
    /* Fluid so the round portrait never crowds narrow phones, capped at the
       original 280px on larger screens. */
    width: min(280px, 72vw);
    height: min(280px, 72vw);
    margin-bottom: 1.5rem;
    background-color: transparent;
    border-radius: 50%;
    overflow: hidden;
  }

  .minds__blob {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 15%;
    bottom: 10%;
    opacity: 0.35;
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    animation: blob-morph var(--blob-duration) ease-in-out infinite;
    z-index: 0;
  }

  .minds__blob--green {
    background-color: var(--color-accent-soft);
  }

  .minds__blob--red {
    background-color: var(--color-accent);
  }

  @keyframes blob-morph {
    0%, 100% {
      border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    }
    25% {
      border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%;
    }
    50% {
      border-radius: 50% 60% 30% 60% / 30% 50% 70% 60%;
    }
    75% {
      border-radius: 60% 30% 60% 40% / 70% 40% 50% 60%;
    }
  }

  .minds__portrait {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: transparent;
    transition: transform var(--duration-hover) var(--easing);
  }

  .minds__portrait-wrapper:hover .minds__portrait {
    transform: scale(1.08);
  }

  .minds__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(42, 33, 27, 0.78);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.85);
    backdrop-filter: blur(2px);
    transition:
      opacity var(--duration-hover) var(--easing),
      transform var(--duration-hover) var(--easing);
  }

  .minds__portrait-wrapper:hover .minds__overlay {
    opacity: 1;
    transform: scale(1);
  }

  .minds__tag {
    color: var(--color-white);
    font-family: var(--font-mono);
    font-size: var(--font-size-mono-sm);
    font-weight: var(--font-weight-mono);
    letter-spacing: var(--letter-spacing-mono);
  }

  .minds__name {
    font-size: 1.6rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .minds__role {
    font-size: 0.95rem;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .minds__qual {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .minds__bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
    max-width: 40ch;
    text-align: left;
  }

  .minds__bio p {
    font-size: 1rem;
    line-height: var(--line-height-body);
    color: var(--color-text);
  }

  .minds--expanded .minds__person {
    text-align: center;
  }

  @media (min-width: 768px) {
    .minds {
      padding: var(--section-padding) 6rem;
    }

    .minds__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .minds {
      opacity: 1;
      transform: none;
    }

    .minds__blob {
      animation: none;
    }
  }
</style>
