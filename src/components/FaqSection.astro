---
/**
 * FaqSection — common questions as native details/summary disclosures.
 *
 * Uses <details>/<summary> so expand and collapse work with zero JavaScript.
 * Content comes from FAQ_ITEMS (single source of truth shared with the FAQPage
 * structured data), so the markup and JSON-LD never disagree.
 */
import { FAQ_ITEMS, type FaqItem } from '../lib/site';

interface Props {
  items?: FaqItem[];
  heading?: string;
  /** Render the component's own heading. Set false when the page supplies one. */
  showHeading?: boolean;
}

const { items = FAQ_ITEMS, heading = 'Common Questions', showHeading = true } =
  Astro.props;
---

<section
  class="faq scroll-reveal"
  aria-label={showHeading ? undefined : 'Common questions'}
  aria-labelledby={showHeading ? 'faq-heading' : undefined}
>
  {showHeading && <h2 class="faq__heading" id="faq-heading">{heading}</h2>}
  <div class="faq__list">
    {
      items.map((item) => (
        <details class="faq__item">
          <summary class="faq__question">
            <span>{item.question}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .faq__heading {
    font-family: var(--font-mono);
    font-size: var(--font-size-mono);
    font-weight: var(--font-weight-mono);
    letter-spacing: var(--letter-spacing-mono);
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  .faq__list {
    border-top: var(--rule-hair) solid var(--color-divider);
  }

  .faq__item {
    border-bottom: var(--rule-hair) solid var(--color-divider);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.5vw, 1.45rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.015em;
    color: var(--color-text);
  }

  /* Remove the default disclosure triangle. */
  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    background-color: var(--color-accent);
    transition: transform var(--duration-hover) var(--easing);
  }

  /* Horizontal bar. */
  .faq__icon::before {
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    transform: translateY(-50%);
  }

  /* Vertical bar (becomes hidden when open, turning + into -). */
  .faq__icon::after {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
  }

  .faq__item[open] .faq__icon::after {
    transform: translateX(-50%) scaleY(0);
  }

  .faq__answer {
    padding-bottom: 1.5rem;
    max-width: var(--reading-measure);
  }

  .faq__answer p {
    font-size: 1.05rem;
    line-height: var(--line-height-body);
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__icon::before,
    .faq__icon::after {
      transition: none;
    }
  }
</style>
