---
---

<div class="floating-shapes" aria-hidden="true">
  <div class="floating-shape floating-shape--1" data-speed="0.12">
    <svg width="24" height="24" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
  </div>
  <div class="floating-shape floating-shape--2" data-speed="0.18">
    <svg width="18" height="18" viewBox="0 0 18 18"><rect x="2" y="2" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.2" transform="rotate(15 9 9)"/></svg>
  </div>
  <div class="floating-shape floating-shape--3" data-speed="0.09">
    <svg width="20" height="20" viewBox="0 0 20 20"><polygon points="10,1 19,17 1,17" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
  </div>
  <div class="floating-shape floating-shape--4" data-speed="0.15">
    <svg width="16" height="16" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
  </div>
  <div class="floating-shape floating-shape--5" data-speed="0.2">
    <svg width="14" height="14" viewBox="0 0 14 14"><path d="M7 1 L13 7 L7 13 L1 7 Z" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
  </div>
  <div class="floating-shape floating-shape--6" data-speed="0.1">
    <svg width="22" height="22" viewBox="0 0 22 22"><path d="M11 1 L13 8 L20 8 L14 12 L16 19 L11 15 L6 19 L8 12 L2 8 L9 8 Z" fill="none" stroke="currentColor" stroke-width="1"/></svg>
  </div>
</div>

<script>
  function initFloatingShapes() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const container = document.querySelector('.floating-shapes') as HTMLElement | null;
    if (!container) return;
    if (container.dataset.motionInit === 'true') return;
    container.dataset.motionInit = 'true';

    const shapes = container.querySelectorAll('.floating-shape') as NodeListOf<HTMLElement>;
    let ticking = false;

    function updateShapes() {
      if (!ticking) {
        requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          shapes.forEach((shape) => {
            const speed = parseFloat(shape.dataset.speed || '0.1');
            const offset = -(scrollY * speed);
            shape.style.transform = `translateY(${offset}px)`;
          });
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', updateShapes, { passive: true });
    updateShapes();
  }

  document.addEventListener('astro:page-load', initFloatingShapes);
</script>

<style>
  .floating-shapes {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .floating-shape {
    position: absolute;
    color: var(--color-divider);
    opacity: 0.5;
    will-change: transform;
  }

  .floating-shape--1 {
    top: 15%;
    left: 8%;
  }

  .floating-shape--2 {
    top: 35%;
    right: 6%;
  }

  .floating-shape--3 {
    top: 55%;
    left: 12%;
  }

  .floating-shape--4 {
    top: 72%;
    right: 10%;
  }

  .floating-shape--5 {
    top: 25%;
    right: 18%;
  }

  .floating-shape--6 {
    top: 85%;
    left: 5%;
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-shapes {
      display: none;
    }
  }
</style>
